# ServerPulse backend URL
SERVER_PULSE_URL=http://localhost:8080

# API key revealed by POST /api/v1/servers/<server-id>/api-key
SERVER_PULSE_API_KEY=your-api-key-here

# Push interval in seconds
SERVER_PULSE_INTERVAL=30

# Identity reported to the backend. Defaults to the local hostname.
# SERVER_PULSE_NAME=web-01
# SERVER_PULSE_HOST=192.168.1.10
# SERVER_PULSE_PORT=0
# SERVER_PULSE_DESCRIPTION=frontend host

# Path to PM2's RPC unix socket. Defaults to ~/.pm2/rpc.sock.
# PM2_SOCKET_PATH=/home/user/.pm2/rpc.sock
