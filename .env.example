# ---------- Image tags ----------
BACKEND_VERSION=dev
FRONTEND_VERSION=dev

# ---------- Backend run-time ----------
GIN_MODE=release
ORIGINS="*"

# --- Host-socket plumbing (so the container can reach the host's daemons
# without installing anything inside it) ---
#
# PM2_HOME: directory on the Docker host that contains PM2's rpc.sock.
#           Bind-mounted into the container at /run/pm2 (chosen because
#           /run is mode 0755 in distroless, so any uid can traverse it).
# PM2_SOCKET_PATH: where that socket ends up inside the container.
#                  Leave at /run/pm2/rpc.sock unless PM2_HOME points
#                  somewhere else inside the container.
# HOST_UID / HOST_GID: UID/GID of the user that owns PM2 on the host.
#                      Find yours with `id -u` / `id -g`.
# DOCKER_GID: GID of the docker group on the host. Find it with
#             `stat -c %g /var/run/docker.sock`. Required so the
#             container can reach the docker socket.
PM2_HOME=/home/ali/.pm2
PM2_SOCKET_PATH=/run/pm2/rpc.sock
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=125

# ---------- Service-history snapshotter ----------
# How often the backend polls PM2/Docker and writes a row to
# the service_history time-series collection.
# Accepts any Go duration string: "30s", "1m", "5m".
HISTORY_POLL_INTERVAL=30s

# How long snapshots are kept before Mongo's TTL drops them.
# Accepts Go duration strings only ("24h", "168h", "720h"). Days ("7d")
# are not parseable by time.ParseDuration.
HISTORY_RETENTION=168h

# ---------- Database (MongoDB) ----------
DB_HOST=mongo
DB_PORT=27017
DB_USERNAME=ali
DB_PASSWORD=123

# ---------- Frontend build-time ----------
# Leave VITE_SERVER_ADDRESS empty so requests go same-origin to /api/*
# and nginx (frontend/nginx.conf) reverse-proxies them to the backend.
# Set it (e.g. http://localhost:12000) only for `pnpm dev` outside Docker.
VITE_SERVER_ADDRESS=
VITE_API_BASE_URL=/api/v1
VITE_API_TIME_OUT=10000
VITE_ENVIRONMENT=development
VITE_APP_NAME=ServerMon
VITE_APP_VERSION=1.0.0

# Frontend host port (container listens on 80)
FRONTEND_PORT=8080
